{
  "name": "skills",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install --force || true",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "chex prose length links readmes skill && bun scripts/search-scope/check-search-scope.ts .",
    "test": "bun test",
    "ci:send-sync": "bun scripts/send-sync/send-sync.ts"
  },
  "devDependencies": {
    "@zgeoff/chex": "0.2.5",
    "@zgeoff/skill-gate": "0.2.27",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0"
  },
  "packageManager": "bun@1.4.4"
}
